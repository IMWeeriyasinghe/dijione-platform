flowchart TB
    U["User (browser)"]

    subgraph FRONTEND["Frontend zones (Next.js 16, Multi-Zones)"]
        Shell["shell-web :3000\nDijiOne Home, common nav/auth,\ngateway rewrites (pages + APIs)"]
        AdminWeb["admin-web :3001\nbasePath /admin\nAdmin Center pages"]
        TalentWeb["talent-web :3002\nbasePath /talent-flow\nDijiTalentFlow pages"]
    end

    subgraph PACKAGES["Shared packages (npm workspace)"]
        DS["@dijione/design-system\nUI primitives + shell chrome"]
        AuthTS["@dijione/auth-client\nsession/auth logic"]
        Contracts["@dijione/contracts\nshared TS types"]
    end

    subgraph BACKEND["Backend services (FastAPI)"]
        Platform["platform-api :8000\nusers, roles, permissions,\nmodule registry, audit, notifications\nissues JWT + signed claims"]
        AdminAPI["admin-api :8001\nNO database\nforwards caller's bearer token\nto platform-api"]
        TalentAPI["talent-api :8002\nowns talent.db\nauthorizes from JWT claims"]
        BirthdayAPI["birthday-api :8003\nskeleton — health/metadata/summary"]
        SparkAPI["spark-api :8004\nskeleton — health/metadata/summary"]
    end

    PlatformDB[("platform.db")]
    TalentDB[("talent.db")]

    subgraph MOCK["Mocked integration layer (owned by talent-api)"]
        MLever["MockLeverClient"]
        MHub["MockHubSpotClient"]
    end

    subgraph FUTURE["Architecture-ready only — no code executes here"]
        Entra["Microsoft Entra ID SSO"]
        Copilot["Copilot / Cowork orchestration"]
        LiveLever["Live LeverClient"]
        LiveHub["Live HubSpotClient"]
    end

    U --> Shell
    Shell -- "proxy /admin/*" --> AdminWeb
    Shell -- "proxy /talent-flow/*" --> TalentWeb
    Shell -- "proxy /api/auth,/api/modules,/api/notifications" --> Platform
    Shell -- "proxy /api/admin/*" --> AdminAPI
    Shell -- "proxy /api/talent/*" --> TalentAPI
    Shell -- "proxy /api/birthday/*" --> BirthdayAPI
    Shell -- "proxy /api/spark/*" --> SparkAPI

    Shell -.-> DS
    AdminWeb -.-> DS
    TalentWeb -.-> DS
    DS -.-> AuthTS
    DS -.-> Contracts

    AdminAPI -- "bearer token forwarded,\nre-authorized" --> Platform
    AdminAPI -- "internal secret\nclient names/counts" --> TalentAPI
    TalentAPI -- "internal secret\naudit + notifications\n(best-effort)" --> Platform

    Platform --> PlatformDB
    TalentAPI --> TalentDB
    TalentAPI --> MLever
    TalentAPI --> MHub

    Platform -.swap later.-> Entra
    MLever -.swap later.-> LiveLever
    MHub -.swap later.-> LiveHub
    Copilot -. "not built; would call\nservice APIs, never bypassing auth" .-> Shell
