# atwork-api (port 8009) — DijiAtWork module foundation. Copy to .env for
# local overrides. Never commit real values.

APP_ENV=development
DATABASE_URL=sqlite:///./atwork.db
BUSINESS_TIME_ZONE=Asia/Colombo
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3005

# Must match platform-api's PLATFORM_JWT_SECRET exactly.
PLATFORM_JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256

# Must match every other backend service's INTERNAL_SERVICE_SECRET.
INTERNAL_SERVICE_SECRET=dev-only-internal-secret-change-me

# The foundation has no external integrations; only "mock" is meaningful.
INTEGRATIONS_MODE=mock
