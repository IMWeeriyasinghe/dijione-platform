# people-api (port 8006) — DijiOne People / Workforce domain.
# The single DijiOne owner of direct BambooHR access. Copy to .env for
# local overrides.

APP_ENV=development
DATABASE_URL=sqlite:///./people.db
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# BambooHR — never write. Mock by default; a real key only takes effect
# when INTEGRATIONS_MODE is not "mock". Never commit real values.
INTEGRATIONS_MODE=mock
BAMBOOHR_API_KEY=
BAMBOOHR_SUBDOMAIN=

JWT_DEV_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
INTERNAL_SERVICE_SECRET=dev-only-internal-secret-change-me

PLATFORM_API_URL=http://localhost:8000
