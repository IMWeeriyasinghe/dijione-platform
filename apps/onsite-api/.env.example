# onsite-api (port 8008) — Diji On-site application module.
# Reads Azure SQL onsite.* SELECT-only via app/attendance_source/. Copy to .env.

APP_ENV=development
DATABASE_URL=sqlite:///./onsite.db
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3004

# mock (default) or live. Live uses DefaultAzureCredential (az login locally,
# the Container App's system-assigned managed identity in Azure).
INTEGRATIONS_MODE=mock
ONSITE_SQL_SERVER=
ONSITE_SQL_DATABASE=

PLATFORM_JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
INTERNAL_SERVICE_SECRET=dev-only-internal-secret-change-me

PLATFORM_API_URL=http://localhost:8000
# Optional — empty or unreachable means EmpCodes only.
PEOPLE_API_URL=http://localhost:8006
