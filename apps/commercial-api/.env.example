# commercial-api (port 8007) — DijiOne Commercial / CRM domain skeleton.
# Deferred (Architecture Completion Plan Wave F) — mock-only, no live
# HubSpot client, no credential requested. Copy to .env for local overrides.

APP_ENV=development
DATABASE_URL=sqlite:///./commercial.db
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

INTEGRATIONS_MODE=mock
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_BASE_URL=https://api.hubapi.com
# Pre-shared-secret webhook gate (placeholder for HubSpot's real v3
# signature scheme — see Settings.hubspot_webhook_secret). Unset is only
# tolerated when APP_ENV=development.
HUBSPOT_WEBHOOK_SECRET=

JWT_DEV_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
INTERNAL_SERVICE_SECRET=dev-only-internal-secret-change-me

PLATFORM_API_URL=http://localhost:8000
