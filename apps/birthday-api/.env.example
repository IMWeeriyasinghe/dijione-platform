# birthday-api (port 8003) — DijiBirthday service. Copy to .env for local
# overrides.

APP_ENV=development
DATABASE_URL=sqlite:///./birthday.db
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Must match platform-api's JWT_DEV_SECRET exactly.
JWT_DEV_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256

PLATFORM_API_URL=http://localhost:8000
# Must match platform-api's INTERNAL_SERVICE_SECRET.
INTERNAL_SERVICE_SECRET=dev-only-internal-secret-change-me

# mock | live — live requires BAMBOOHR_API_KEY + BAMBOOHR_SUBDOMAIN below
# to be set, or the BambooHR client raises *NotConfiguredError.
INTEGRATIONS_MODE=mock

# mock | live — INDEPENDENT from INTEGRATIONS_MODE (Phase-Next §7/§8):
# lets BambooHR run live while real supplier email sending stays disabled
# during the dry-run phase. Defaults mock. Only flip to live once the
# dry-run workflow has been validated end-to-end AND Graph app
# registration (GRAPH_* vars below) is complete — real supplier email
# sending must never be an accidental side effect of enabling live
# BambooHR.
EMAIL_SENDING_MODE=mock

# BambooHR employee-directory API (read-only; never write to BambooHR).
# Not currently available (CLAUDE.md §58) — leave unset to keep using
# MockBambooHRClient. Auth is basic auth: username=API key, password="x".
BAMBOOHR_API_KEY=
BAMBOOHR_SUBDOMAIN=

# Microsoft Graph — outbound supplier-order email. Only used when
# EMAIL_SENDING_MODE=live; leave unset to keep using MockGraphEmailClient.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_MAILBOX=

