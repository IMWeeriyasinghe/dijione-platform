# birthday-api (port 8003) — DijiBirthday service. Copy to .env for local
# overrides.

APP_ENV=development
DATABASE_URL=sqlite:///./birthday.db
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Must match platform-api's JWT_DEV_SECRET exactly.
JWT_DEV_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256

PLATFORM_API_URL=http://localhost:8000
# people-api owns BambooHR now (Architecture Completion Plan §3) —
# birthday-api holds no BambooHR credential; it consumes the employee
# directory over this URL.
PEOPLE_API_URL=http://localhost:8006
# Must match platform-api's INTERNAL_SERVICE_SECRET.
INTERNAL_SERVICE_SECRET=dev-only-internal-secret-change-me

# mock | live — "live" means call the real people-api (which is where
# BAMBOOHR_API_KEY/BAMBOOHR_SUBDOMAIN now live — see apps/people-api/.env).
INTEGRATIONS_MODE=mock

# mock | live — gates INBOUND supplier-mail polling only (see
# packages/mail-client-py for OUTBOUND, below). Defaults mock.
EMAIL_SENDING_MODE=mock

# --- Outbound mail (packages/mail-client-py) --------------------------
# null | graph. "graph" authenticates via THIS Container App's own
# system-assigned Managed Identity (azure.identity.DefaultAzureCredential)
# — never a client secret. Local dev/tests should never set this to
# "graph" (DefaultAzureCredential has no ambient identity off-Azure).
MAIL_TRANSPORT=null
# disabled (safe default) | internal_allowlist | production. Unknown/
# misconfigured values behave as disabled — fail closed. Only matters
# once MAIL_TRANSPORT=graph; see app/integrations/factory.py.
MAIL_POLICY=disabled
# The one mailbox this service ever sends as, e.g. appassistant@dijitalteam.com.
MAIL_SHARED_MAILBOX=
# Comma-separated exact addresses / "@domain" entries, read only when
# MAIL_POLICY=internal_allowlist. Use one or more explicit test addresses
# for a DEV real-Graph test — never a bare "@dijitalteam.com" domain entry.
MAIL_ALLOWLIST=

# --- Inbound mail (client-credentials, unchanged by the outbound Managed
# Identity migration — see app/integrations/inbound_mail/) -------------
# Only used when EMAIL_SENDING_MODE=live; leave unset to keep using
# MockInboundMailClient.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_INBOX_MAILBOX=
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

