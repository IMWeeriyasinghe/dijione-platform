# recruitment-api (port 8005) — DijiOne Recruitment Source domain.
# The single DijiOne owner of direct Lever access. Copy to .env for local
# overrides.

APP_ENV=development
DATABASE_URL=sqlite:///./recruitment.db
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Lever — GET-only (CLAUDE.md §60). Mock by default; a real key only takes
# effect when INTEGRATIONS_MODE is not "mock". The key MUST stay in this
# service's .env only — never committed, never logged, never in .env.example.
INTEGRATIONS_MODE=mock
LEVER_API_KEY=
LEVER_BASE_URL=https://api.lever.co/v1
LEVER_WEBHOOK_SIGNING_SECRET=

# Must match platform-api's JWT_DEV_SECRET and the shared INTERNAL_SERVICE_SECRET.
JWT_DEV_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
INTERNAL_SERVICE_SECRET=dev-only-internal-secret-change-me

PLATFORM_API_URL=http://localhost:8000
OPPORTUNITY_SYNC_LIMIT=200
