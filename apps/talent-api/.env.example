# talent-api (port 8002) — owns DijiTalentFlow's own data: clients, talent
# requests, candidates, applications, interviews, messages, documents, and
# the client-visibility trust decision (PostingClientMapping). Consumes the
# Recruitment Source domain (recruitment-api) over HTTP — no Lever or
# HubSpot credential lives here. Copy to .env for local overrides.

APP_ENV=development
DATABASE_URL=sqlite:///./talent.db

INTEGRATIONS_MODE=mock
RECRUITMENT_API_URL=http://localhost:8005

AZURE_STORAGE_CONNECTION_STRING=

API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Must match platform-api's JWT_DEV_SECRET exactly — talent-api verifies
# tokens locally from claims, never by calling Platform Core.
JWT_DEV_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256

PLATFORM_API_URL=http://localhost:8000
# Must match platform-api's INTERNAL_SERVICE_SECRET.
INTERNAL_SERVICE_SECRET=dev-only-internal-secret-change-me

# DijiTalentFlow magic-link external client sessions — deliberately a
# DIFFERENT secret from JWT_DEV_SECRET above, so an internal staff token
# and an external client-session token can never be confused for one
# another (see get_talent_external_scope in app/api/deps.py). Local-dev
# default only; production provisioning is a separate future cloud task.
EXTERNAL_SESSION_JWT_SECRET=dev-only-external-session-secret-change-me
EXTERNAL_SESSION_JWT_ISSUER=dijitalent-external
# External sessions are short-lived and non-refreshable; the portal SPA
# silently re-redeems the stored raw token for a fresh session while the
# grant is still valid. Keep inside 30–60.
EXTERNAL_SESSION_JWT_TTL_MINUTES=45
# Origin of the Client Talent Review Workspace (talentflow-portal) — used
# only to build the one-time access URL a TA copies (<base>/access#<token>).
EXTERNAL_PORTAL_BASE_URL=http://localhost:3100
EXTERNAL_GRANT_DEFAULT_EXPIRY_DAYS=14
