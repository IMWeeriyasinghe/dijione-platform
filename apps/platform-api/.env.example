# platform-api (port 8000) — owns identity, authorization, module registry,
# audit log, notifications. Copy to .env for local overrides.

APP_ENV=development
DATABASE_URL=sqlite:///./platform.db

DEV_IDENTITY_MODE=true
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:3000/api/auth/callback

API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
JWT_DEV_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720

# Shared across every backend service — must be identical everywhere.
INTERNAL_SERVICE_SECRET=dev-only-internal-secret-change-me

# talent-api base URL — used only by the temporary client-scope guard
# (validates a client_id in a module/group scope actually exists). Remove
# once the Commercial/CRM domain issues canonical client ids.
TALENT_API_URL=http://localhost:8002
