# admin-api (port 8001) — DijiOne Admin Center. Owns no database; forwards
# every request to platform-api (with the caller's own bearer token) and
# enriches with talent-api data. Copy to .env for local overrides.

APP_ENV=development

PLATFORM_API_URL=http://localhost:8000
TALENT_API_URL=http://localhost:8002

# Must match platform-api's and talent-api's INTERNAL_SERVICE_SECRET.
INTERNAL_SERVICE_SECRET=dev-only-internal-secret-change-me

API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
