# DijiOne Platform — environment contract
# Copy to .env and fill in for local development. No production secrets are
# committed to this repository. See CLAUDE.md §58 and §74.

APP_ENV=development

# --- Database -----------------------------------------------------------
# Local MVP uses SQLite. Production target is PostgreSQL; the DSN shape
# below is compatible with both via SQLAlchemy.
DATABASE_URL=sqlite:///./dijione.db

# --- Auth: Microsoft Entra ID (production target, not required locally) --
# DEV_IDENTITY_MODE=true switches the API/web app to the local persona
# switcher instead of requiring Entra ID. See docs/platform/authentication.md
DEV_IDENTITY_MODE=true
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:3000/api/auth/callback

# --- Integrations (mock providers used until credentials are supplied) --
INTEGRATIONS_MODE=mock
LEVER_API_KEY=
LEVER_BASE_URL=https://api.lever.co/v1
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_BASE_URL=https://api.hubapi.com

# --- Storage (future document uploads) -----------------------------------
AZURE_STORAGE_CONNECTION_STRING=

# --- Web app --------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development

# --- Backend security -----------------------------------------------------
# Next.js falls back to :3001, :3002, ... if :3000 is already taken locally.
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
JWT_DEV_SECRET=dev-only-insecure-secret-change-me
