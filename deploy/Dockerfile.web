# syntax=docker/dockerfile:1
#
# One image for every Next.js app. Build context = repo root.
#   docker build -f deploy/Dockerfile.web --build-arg APP=shell-web  -t dijione/shell-web .
#   docker build -f deploy/Dockerfile.web --build-arg APP=talent-web -t dijione/talent-web .
#   (also: admin-web, birthday-web, birthday-supplier-web)
#
# Uses Next.js `output: "standalone"` (set in each app's next.config.ts).
# The apps `transpilePackages` the workspace packages (design-system,
# auth-client-ts, contracts) from source, so the whole repo is the context
# and `npm ci` at the root wires the workspace symlinks.
#
# Upstream URLs are read from the environment at server start
# (PLATFORM_API_URL, TALENT_API_URL, ...) — see each next.config.ts.

# Keep in sync with .nvmrc (the CI web workflow and the local dev tooling both
# read .nvmrc). Bump both together if the Node baseline changes.
ARG NODE_VERSION=20

# ---- build ----
FROM node:${NODE_VERSION}-slim AS build
ARG APP
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /repo

# Next.js evaluates next.config.ts `rewrites()` at BUILD time and bakes the
# resolved destinations into .next/routes-manifest.json — the standalone
# server does NOT re-read process.env at runtime. So the upstream URLs must be
# present here. Defaults are the ACA internal DNS names, which are identical in
# every DijiOne environment (dev/uat/prod each has its own `platform-api` at
# http://platform-api), so the image stays immutable / promotable. Override
# with --build-arg only for a genuinely different topology (e.g. Front Door).
ARG PLATFORM_API_URL=http://platform-api
ARG ADMIN_API_URL=http://admin-api
ARG TALENT_API_URL=http://talent-api
ARG BIRTHDAY_API_URL=http://birthday-api
ARG SPARK_API_URL=http://spark-api
ARG ADMIN_WEB_URL=http://admin-web
ARG TALENT_WEB_URL=http://talent-web
ARG BIRTHDAY_WEB_URL=http://birthday-web
ENV PLATFORM_API_URL=${PLATFORM_API_URL} \
    ADMIN_API_URL=${ADMIN_API_URL} \
    TALENT_API_URL=${TALENT_API_URL} \
    BIRTHDAY_API_URL=${BIRTHDAY_API_URL} \
    SPARK_API_URL=${SPARK_API_URL} \
    ADMIN_WEB_URL=${ADMIN_WEB_URL} \
    TALENT_WEB_URL=${TALENT_WEB_URL} \
    BIRTHDAY_WEB_URL=${BIRTHDAY_WEB_URL}

# Per-app footer version/build metadata (docs/platform/versioning.md). The
# app VERSION itself is read from each app's own package.json at build time
# (never a build arg — it must never drift from what's committed); only the
# two values package.json can't know come in as build args: the exact
# commit this image was built from, and when. Each app's next.config.ts
# reads these via process.env and re-exposes them as NEXT_PUBLIC_* so
# Next's build-time replacement bakes an app-specific literal into that
# app's own client bundle — see VersionFooter's own doc comment for why one
# shared component still renders different values per app.
ARG GIT_SHA=unknown
ARG BUILD_DATE=unknown
ENV GIT_SHA=${GIT_SHA} \
    BUILD_DATE=${BUILD_DATE}

COPY package.json package-lock.json .nvmrc ./
COPY packages ./packages
COPY apps ./apps
RUN npm ci
RUN npm run build --workspace apps/${APP}
# `public/` is optional for a Next.js app (birthday-web / birthday-supplier-web
# have none). Guarantee it exists so the run-stage COPY below never fails.
RUN mkdir -p apps/${APP}/public

# ---- run ----
FROM node:${NODE_VERSION}-slim AS run
ARG APP
ENV APP=${APP} \
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1
WORKDIR /app

# Standalone bundle: a self-contained server + traced node_modules + the
# traced workspace packages. In a monorepo the server entry is at
# apps/<APP>/server.js relative to the standalone root. `--chown` so the
# non-root user below owns the files it serves.
COPY --from=build --chown=node:node /repo/apps/${APP}/.next/standalone ./
COPY --from=build --chown=node:node /repo/apps/${APP}/.next/static ./apps/${APP}/.next/static
COPY --from=build --chown=node:node /repo/apps/${APP}/public ./apps/${APP}/public

# Run as the unprivileged `node` user (uid 1000, ships with the base image).
USER node

# Container Apps sets $PORT; Next standalone honours PORT/HOSTNAME.
ENV PORT=3000 HOSTNAME=0.0.0.0
EXPOSE 3000
CMD ["sh", "-c", "exec node apps/${APP}/server.js"]
