# syntax=docker/dockerfile:1
#
# One image for every FastAPI service. Build context = repo root.
#   docker build -f deploy/Dockerfile.api --build-arg SERVICE=platform-api  -t dijione/platform-api .
#   docker build -f deploy/Dockerfile.api --build-arg SERVICE=talent-api     -t dijione/talent-api .
#   (also: admin-api, recruitment-api, people-api, commercial-api, birthday-api, spark-api)
#
# Multi-stage: the build stage installs dependencies into a venv; the run
# stage copies only the venv + the service code + the shared editable
# package, drops the build toolchain, and runs as a non-root user.
#
# Every *-api requirements.txt installs `packages/auth-client-py` editable
# via `-e ../../packages/auth-client-py`. pip resolves that path relative to
# the CWD, so the install MUST run from /app/apps/${SERVICE} for it to land on
# /app/packages/auth-client-py — which is copied to the SAME absolute path in
# both stages so the editable link keeps resolving at runtime.
#
# The same image also backs the scheduled Container Apps Jobs (deploy/),
# whose command is a `curl` to an internal endpoint — hence curl is
# installed in the run stage.

ARG PYTHON_VERSION=3.12

# ---- build: dependencies into a venv --------------------------------------
FROM python:${PYTHON_VERSION}-slim AS build
ARG SERVICE
ENV PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    SERVICE=${SERVICE}
WORKDIR /app

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

# Shared editable package first (referenced by ../../packages/auth-client-py).
COPY packages/auth-client-py ./packages/auth-client-py

# Dependencies. Run pip FROM the service directory so the requirements file's
# `-e ../../packages/auth-client-py` resolves to /app/packages/auth-client-py.
# A failure here MUST fail the build (no `|| true`, no cleanup on the same line).
COPY apps/${SERVICE}/requirements.txt ./apps/${SERVICE}/requirements.txt
RUN cd apps/${SERVICE} && pip install -r requirements.txt

# Drop dev-only tooling. Best-effort ONLY — must never be able to mask the
# dependency install above.
RUN pip uninstall -y pytest pytest-asyncio pytest-cov coverage ruff mypy 2>/dev/null || true

# Build-time proof the runtime environment is complete. Phase 2A shipped a
# technically-successful but empty venv; this makes that impossible.
RUN python -c "import fastapi, uvicorn, pydantic, pydantic_settings, httpx, auth_client_py; print('core runtime deps OK for ${SERVICE}')" \
 && if grep -qE '^alembic' "apps/${SERVICE}/requirements.txt"; then \
        python -c "import sqlalchemy, alembic, psycopg; print('db runtime deps OK for ${SERVICE}')"; \
    else \
        echo "no db runtime deps expected for ${SERVICE}"; \
    fi

# ---- run ----------------------------------------------------------------
FROM python:${PYTHON_VERSION}-slim AS run
ARG SERVICE
ENV SERVICE=${SERVICE} \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -r -u 1000 -m -d /home/app app

WORKDIR /app
COPY --from=build /opt/venv /opt/venv
COPY --from=build /app/packages/auth-client-py ./packages/auth-client-py
COPY apps/${SERVICE} ./apps/${SERVICE}
RUN chown -R app:app /app

USER app
WORKDIR /app/apps/${SERVICE}

# Container Apps sets $PORT; default 8000 for local runs.
EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
