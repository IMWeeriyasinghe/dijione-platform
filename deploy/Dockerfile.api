# syntax=docker/dockerfile:1
#
# One image for every FastAPI service. Build context = repo root.
#   docker build -f deploy/Dockerfile.api --build-arg SERVICE=platform-api  -t dijione/platform-api .
#   docker build -f deploy/Dockerfile.api --build-arg SERVICE=talent-api     -t dijione/talent-api .
#   (also: admin-api, recruitment-api, people-api, commercial-api, birthday-api, spark-api)
#
# Multi-stage: the build stage installs dependencies into a venv; the run
# stage copies only the venv + the service code + the shared editable
# package, drops the build toolchain, and runs as a non-root user.
#
# Every *-api requirements.txt installs `packages/auth-client-py` editable
# via `-e ../../packages/auth-client-py`, so that path must exist at the
# SAME location (`/app/packages/auth-client-py`) in both stages — hence the
# repo-relative layout below.
#
# The same image also backs the scheduled Container Apps Jobs (deploy/),
# whose command is a `curl` to an internal endpoint — hence curl is
# installed in the run stage.

ARG PYTHON_VERSION=3.12

# ---- build: dependencies into a venv --------------------------------------
FROM python:${PYTHON_VERSION}-slim AS build
ARG SERVICE
ENV PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1
WORKDIR /app

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

# Shared editable package first (referenced by ../../packages/auth-client-py).
COPY packages/auth-client-py ./packages/auth-client-py

# Dependencies (cached layer — only re-runs when requirements.txt changes).
COPY apps/${SERVICE}/requirements.txt ./apps/${SERVICE}/requirements.txt
RUN pip install -r apps/${SERVICE}/requirements.txt \
    && pip uninstall -y pytest pytest-asyncio pytest-cov coverage ruff mypy 2>/dev/null || true

# ---- run ----------------------------------------------------------------
FROM python:${PYTHON_VERSION}-slim AS run
ARG SERVICE
ENV SERVICE=${SERVICE} \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -r -u 1000 -m -d /home/app app

WORKDIR /app
COPY --from=build /opt/venv /opt/venv
COPY --from=build /app/packages/auth-client-py ./packages/auth-client-py
COPY apps/${SERVICE} ./apps/${SERVICE}
RUN chown -R app:app /app

USER app
WORKDIR /app/apps/${SERVICE}

# Container Apps sets $PORT; default 8000 for local runs.
EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
